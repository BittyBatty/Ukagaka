OnKeyPress
*/


//--OnAiTalk
//Leave this alone. This is mostly setting up whether or not dialogue is in a chain before it displays.

OnAiTalk
 {
	if RAND(100) < communicateratio
 	{
 		StartCommunicate
	}
 	else
	{
			if CHAIN.IDName == "" {
 				lastTalk = RandomTalk
			}
			else {
				lastTalk = ChainTalk
			}
			lastTalk
	}
 }
 
//--RandomTalk 

//nonoverlap_pool should make it so all your dialogue has an equal probability of being called, and it will do each line of dialogue before repeating them.

RandomTalk : nonoverlap_pool
{	
	"\0\s[0]\i[5]Did you know ducks have accents?\e"
	
	"\0\s[0]\i[81]What was I doing here again?\e"
	
	"\0\s[0]\i[81]So you really live here?\e"
	
	"\0\s[0]\i[5]I could use a caramel apple about now.\e"
	
	"\0\s[1]\i[2]No one has good taste in musical theater.\e"
	
	"\0\s[1]\i[2]The Great Quacksby was great.\w8 Lousy sinners.\e"
	
	"\0\s[1]Sir Quackington better be okay.\e"
	
	"\0\s[1]Ugh... I can still feel the bad tickles.\e"
	
	"\0\s[1]\i[2]The bellhop won't leave me alone lately.\e"
	
	"\0\s[2]Piping hot pancakes!\w8 I forgot you were here!\e"
	
	"\0\s[2]Augh! I just remembered something! Be right back!\s[-1]\e"
	
	"\0\s[3]What \f[italic,true]did\f[italic,false] you do to end up in Hell...\w8 hmmmm...\e"
	
	"\0\s[3]I have an important question for you!\w8\s[6] How do you feel about pancakes?\e"
	
	"\0\s[3]Protecting Charlie's hotel is going to be hard.\e"
	
	"\0\s[3]I don't know if I can pull this off.\e"
	
	"\0\s[4]I hope Charlie's not still mad at me.\e"
	
	"\0\s[3]Hmmmmmmm...\w8\s[5]\i[3]I just had another idea for a duck!\e"
	
	"\0\s[3]Huh.\w8 For a sinner, you don't smell too bad.\e"
	
	"\0\s[0]\f[color,255,255,255](Sniff, Sniff)\f[color,default] I smell food.\w8 Is it you?\w8\s[0]\i[5] Can I have some?\e"
	
	"\0\s[3]Have you ever heard polka music?\w8 \s[6]First time I did, I was DAZZLED!\e"
	
	"\0\s[1]\i[2] Red Guy's been playing a lot of very loud jazz.\w8 He's so annoying.\e"
	
	"\0\s[3]I don't know about your decorating around here.\e"
	
	"\0\s[6]Saaaaaaaay...\w8 I don't see enough ducks in your room.\e"
	
	"\0\s[0]\i[5]Heh...\w8 I learned how my own blood tastes recently.\w8\w8 Ho boy... \s[1]Not pleasant.\e"
	
	"\0\s[0]\i[5] You ever hear of a thing called apple cider?\w8 It tastes SO good.\w8 I might switch from coffee!\e"
	
	"\0\s[0]Don't turn the lights off... mmkay?\0\s[0]\i[83]\e"
	
	"\0\s[1]\i[2]\f[height,14]When I get my hands on TV Head Man...\w8 \n\n[half]\f[height,12]I'm really \f[height,10]\n\n[half]going to...\w8 to...\s[1]\n\n[half]\f[height,8]not do anything\f[height,6]\n\n[half]because I can't\f[height,4]\n\n[half]and he knows\f[height,2]\n\n[half]that I can't...\e"
	
	//"\0\s[0]I am pausing \w4for dramatic \w6emphasis. \w8P\w6 - \w6A - \w6U - \w6S - \w6E.\e"
	
	//"\0\s[0]This is dialogue referring to %(username).\e"
	
	//"\w8\0\s[0]%(shadowdiscovered) which is in word.dic.\e"
	
	//"\0\s[0]%(blanklist2) which is in word.dic.\e"
	
	//"\0\s[0]%(blanklist3) which is in word.dic.\e"
	
	//"\0\s[0]%(internalfunction) which is in word.dic.\e"
	
	//"\0\s[0]Do whatever you want.\w8\0\n\n[half]\s[3]Playing with power even, you could say.\e"
	
	//--Chains
	//A dialogue chain consists of multiple bits of dialogue that get called in order over a period of time.
	
	"\0\s[3]Hmmmmmmmmmmmmm...\e:chain=achain"
	
	"\1\s[11]\e:chain=anotherchain"
	
	
	//--If statements
	
	if nowshell == "master" //This checks to see what shell they're currently using. 
	{
		"\0\s[6]I still look snazzy even without my coat and hat, don't I?\e"
	}
	
	if month >= 12
	{
		"\0\s[6]Sinsmas is coming up.\e"
		
		"\0\s[5]I know just what I want to get Char-Char for Sinsmas this year!\e"
	}
	
	if weekday == 1
	{
		"\0\s[6]Mondays, amirite?\e"
	}
	
	//This if checks for the time of day as defined in bootend.dic.
	if timeslot == "earlymorning"
	{
		"\0\s[6]Woah-oh! We have an early bird here just like me!\e"
	}
	
	
	//--Double Functions or Arrays
	
	//note that this is enclosed in its own set of brackets, Basically this works like a list but if you want two linked things to be able to be pulled up to "randomize" the dialogue a little
	//{
	//	_korean = lessonkor //Here, "lessonkor" (which is in word.dic) is stored as a new temporary value called _korean.
	//	_korword = _korean[0] //Now we make a temporary value called "_korword", which is what will store the Korean word. ALWAYS START WITH 0
	//	_kormean = _korean[1] //Now we make a temporary value called "_kormean", which is what will store the meaning of the Korean word.
	
		//Now we put it all together!
	//	"\0\Here is an example of an array. The Korean word is %(_korword).\w8\0\s[0]The word means %(_kormean).\e"
	
		//The underscores in front of korword and kormean mean that the value is temporary, and will disappear when the dialogue has finished. More on this kind of thing on the coding page of the walkthrough.
	
		//Additional Note - You can't test this kind of dialogue in Script Input.
	//}
	
	//--Multiple Responses
	
	//{
	//	"\0\s[0]Say either black or white.\w8 What if I say " 
	//	-- //opening dashes
	//	"green"
	//	"red"
	//	"purple"
	//	"orange"
	//	"yellow"
	//	"\s[5]magenta" //Notice here I added a tag for his thoughtful pose. If he chooses magenta, he'll do this pose. You can set up individual expressions for each potential choice this way.
	//	-- //closing dashes
	//	" instead?\w8\0\n\n[half]\s[9]Then you're not really cooperating.\w8\e" //dialogue ends
	//}
	
	//Font Effects
	
	//"\0\s[0]\f[strike,true]These words are struck out.\f[strike,default]\w8\f[sub,true]These words are a subscript.\f[sub,false] \f[sup,true]These words are a superscript.\f[sup,false] \f[underline,true]These words are underlined.\f[underline,default] \f[bold,true]These words are bold.\f[bold,false] \f[italic,true]These words are italic.\f[italic,false] \f[color,186,146,112]These words are a color.\f[color,default] This tag would return to default.\f[default]\e"
	
	//"\0\s[0]\f[height,20]These words are really large.\f[height,default]\w8 These words are a normal size. \w8\f[height,6]These words are small.\f[height,default]\e"
}


//--Chains

achain
{{CHAIN
	//second dialogue
	"\0\s[3]What if I just made a big old bubble that protects the hotel?\e"
	
	//third dialogue
	"\0\s[3]... And then there can be a duck with %(duckweapons)!\e"
	
	//last dialogue
	"\0\s[1]Who am I kidding?\w8 They're all awful ideas!\e:chain=end"
}}CHAIN

//Note also it ends with \e:chain=end, basically ending the chain.

anotherchain
{{CHAIN
	"\1\s[11]\5\e"
	
	"\1\s[11]\i[1]\w8\w8\w8\w8\1\s[12]\e"
	
	"\1\s[-1]\e:chain=end"
}}CHAIN


//Keeps track of if an hour has passed. Just ignore this.
HourCheck
{
if passmin >= 59
	{
		passmin = 0
		passhour = passhour + 1
	}
}


OnMinuteChange //This is what will trigger time-based dialogue for your Ghost.
 {
	HourCheck //checks to see if an hour has passed, ignore it
	--
 	// if minute == 0 //These ifs will check what time it is. Here, it's seeing if the minute equals zero...
	// {
 		// if hour == 12 //And the hour equals 12, meaning it's noon. You can change this to some other hour if you want.
		// {
 			// "\0\s[0]It's noon.\w8\1\s[15]Let's have a showdown!\w8\0\n\n[half]\s[9]There are no corrals here, dude.\e"
			// //Replace with appropriate dialogue as you want.
		// }
	
	//Don't touch this part.
	// elseif mikireflag == 1
 	// {
 		// MikireTalk
	// }
 }

//--OnSecondChange
//Like the above, this handles what happens every time a second goes by. Most of this you will not have to touch.

OnSecondChange
 {
	if passsec == 59
 		{
	 	passsec = 0
 		passmin = passmin + 1
		}
 	else
 		{
	 	passsec = passsec + 1
		}
 }


//**** OnSurfaceRestore *****************************************************************
//OnSurfaceRestore makes it so that that after a short period of time, the ghost will go back to its default pose, so you won't have a ghost stuck in one expression for too long. 

OnSurfaceRestore
 {
 	if reference0 == 7 || reference0 == 8 //This looks to see if Lucifer is in pose 7 or pose 8, since he is reference0.
 	{
		"\0\s[0]I'm calm now.\w8 Eeeeyup.\w8 Calm.\e"
 	}
	elseif reference1 == 11
	{
		"\0\s[0]\1\s[11]\e"
	}
	elseif reference1 == 12
	{
		"\0\s[0]\1\s[12]\e"
	}
 	else
 	{
		"\0\s[0]\e"
	}
 }

 
 //--OnKeyPress
 //This defines the hotkeys your ghost will use.
 
OnKeyPress
{
	if reference0 == "t"
	{
	OnAiTalk
	}
	elseif reference0 == "r"
	{
	OnLastTalk
	}
	elseif reference0 == "f1"
	{
	"\![open,readme]"
	}
}