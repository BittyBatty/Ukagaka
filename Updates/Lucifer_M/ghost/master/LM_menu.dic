//---------------------------Menus--------------------------
//This .dic file is primarily concerned with the double-click menus for each of your ghosts.


//--OpenSakuraMenu
//This is a bit of intro dialogue before the main character opens their menu. Note that none of the lines end with \e!

//The \b2 tag tells the ghost to use their big balloon for this dialogue. If your menu has a lot of stuff, this'll probably look better than the small one.

OpenSakuraMenu
{
		"\0\s[0]\b2What's that now?"
		"\0\s[6]\b2Need something from me do ya?"
		--
		MenuRun
}

//--MenuRun
//As you just saw above. This actually fills out the rest of the menu. If you're going to be adding or changing functions, this is where you'll be doing your edits.

MenuRun : all
 {	
 	wd = GetWeekDay
 	ap = GetAP
	//It's putting together the information to display the time at the bottom of the balloon. Pay it no mind.
	--
	"\n\n\_q\b2"
	--
	if lastTalk != "" //What this does is check to see if the ghost has already said a random bit of dialogue on its own, essentially by seeing if the lastTalk thing is NOT empty (!= means "does not equal").
	{
	  "\![*]\q[What did you just say,OnLastTalk]\n"
	  //If the ghost has said something, it will then display this menu option. 
	}
	--
 	"\![*]\q[Say something,OnAiTalk]\n\n[half]"
	--
	//"\![*]\q[Testing Variables,testing]\n\n"
	if shadowdiscovered == 1 && ToldAboutShadow == 0
	{
		"\![*]\q[Tell Him About the Shadow,tellaboutshadow]\n\n"
	}
	if ToldAboutShadow == 1
	{
		"You have Dispelled Alastor's Shadow %(DispelledShadow) Times.\n\n"
	}
	--
	"\![*]\q[User Settings,configmenu]\n\n"
 	"\![*]\q[Nevermind,CANCEL]\n\n\n[half]\e"
	
	//These three lead to the Config Menu, the Function menu, and Cancel. You can leave these alone if you like. All the %()s at the end (see word.dic) basically display the year, month, day, weekday, and time.
}

//Leave this alone
OnLastTalk 
{
"\0\s[3]Uhhh...\w8 Give me a minute...\w8 I said...\w8 Uhhh...\w8 It's coming to me...\w8 Oh!\w8\w8\n\n%(lastTalk)\e"

"\0\s[0]\i[5]Hahahaha!\w8 Oh... \w8I have NO idea.\e"
}

Select.tellaboutshadow
{
	"\t\*\0\s[2]\w8\w8WHAT?!\w8 That tacky piece of shit found me here?\w8\0\s[1]\i[2] But I was so careful!\w8\s[3] Saaaaaaay you've been a big help to me...\s[6] Do you think you can scare that shadow off next time you see it?%(ToldAboutShadow = 1)\x\e"
}

Select.testing
{
	"\_q\b2Shadow Discovered %(shadowdiscovered)\nHorns %(HasHorns)\nAntlers %(HasAntlers)\nHair %(HasHair)\nEars %(HasEars)\nTail %(HasTail)\nWings %(HasWings)\nT and W %(HasTandW)\nClothes %(HasClothes)\nToldAboutShadow %(ToldAboutShadow)\n First Boot Trigger %(firstboot)\n\n"
	
	--
	"\![*]\q[Test First Boot,TestingFirstB]\n\![*]\q[Wipe Variables Clean,WipeClean]\n\n\![*]\q[Back to the menu,BACKTOMENU]\e"
}

Select.TestingFirstB
{
	"\![raise,OnFirstBoot,0]\e"
}

Select.WipeClean
{
	HasHorns = 0
	HasAntlers = 0
	HasHair = 0
	HasEars = 0
	HasTail = 0
	HasWings = 0
	HasTandW = 0
	HasClothes = 0
	ToldAboutShadow = 0
}

//This is figuring out what day of the week it is. Leave it alone.
GetWeekDay
{
	if weekday == 0
	{"Sun"}
	elseif weekday == 1
	{"Mon"}
	elseif weekday == 2
	{"Tue"}
	elseif weekday == 3
	{"Wed"}
	elseif weekday == 4
	{"Thu"}
	elseif weekday == 5
	{"Fri"}
	else
	{"Sat"}
}

//This is finding out whether it's AM or PM. Leave it alone.
GetAP
{
 	if hour >= 0 && hour <= 11
 		{"AM"}
 	else
 		{"PM"}
}

nowhour
{
	if hour12 == 0; "1"
	else; "%(hour12)"
}

nowmin
{
	if minute >= 0 && minute <=9; "0%(minute)"
	else; "%(minute)"
}


//If someone selects an option linked to BACKTOMENU, it will go back to MenuRun.

Select.BACKTOMENU
	{
		MenuRun
	}

//If someone selects configmenu, this will lead to TalkConfig.
Select.configmenu
	{
		TalkConfig
	}

//--TalkConfig
//This menu allows the user to change their name and other information, as well as put in their birthday and change how often the ghost speaks.

TalkConfig : all
{
	"\0\b[2]\_q\" 
	
	"f[bold,1]Your name:\f[bold,0] %(username) \f[sup,1](\q[Change it?,TEACHNAME])\f[sup,0]\n"
	
	"\f[bold,1]Your Appearance:\f[bold,0] %(WhatUserLooksLike) \f[sup,1](\q[Change it?,ChangeAppearance])\f[sup,0]\n"
	
	
	//If you want your user to set their pronouns
	//"\f[bold,1]Your pronouns:\f[bold,0] %(heshe)/%(himher)/%(hisher) \f[sup,1](\q[Change them?,TEACHPRONOUN])\f[sup,0]\n"
	
	
	//If you want your user to be able to set their birthday
	//"\f[bold,1]Your birthday:\f[bold,0] %(birthdayprint) \f[sup,1](\q[Change it?,TEACHBDAY])\f[sup,0]\n"
	
	
	
	"\n\f[bold,1]Talk Rate:\f[bold,0] - every %(talktime) \f[sup,1](\q[Change it,talkinter])\f[sup,0]\n\n"
	
	"\![*]\q[Open SSP Preferences,sspconfig]\n\n"
	
	
		{
		"\![*]Enable Uninstall? (NOW : %(deleteshitai))\n\q[ON,deleteon] \q[OFF,deleteoff]\n\n[half]\n"
		}
		
	
	
	"\![*]\q[Back to the menu,BACKTOMENU]\e"
}

Select.ChangeAppearance
{
	"\c\t\0\s[3]What's on your head?\n\n"
	--
	"\t\*\![*]\q[Horns,GiveHorns]\n\![*]\q[Antlers,GiveAntlers]\n\![*]\q[Animal Ears,GiveEars]\n\![*]\q[Just Hair,GiveHair]\n\e"
}


